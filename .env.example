# ==============================================================================
# Cybersecurity Operations Center (SOC) Dashboard - Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/soc_platform_db?schema=public"

# Database Container Defaults (used by docker-compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_DB="soc_platform_db"
POSTGRES_PORT=5432

# Runtime Service Mode: 'live' (PostgreSQL backend) or 'mock' (in-memory demo scenario)
NEXT_PUBLIC_DATA_MODE="live"

# Next.js API URL (empty defaults to same-origin /api route handlers)
NEXT_PUBLIC_API_URL="/api"

# JWT Authentication Secret (Change to a cryptographically strong 256-bit+ random secret in production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_chars"
JWT_EXPIRES_IN="8h"

# Environment
NODE_ENV="development"
